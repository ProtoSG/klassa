meta {
  name: Create Fee Schedule
  type: http
  seq: 1
}

post {
  url: {{base_url}}/billing/fee-schedules
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Tenant-Subdomain: {{subdomain}}
}

body:json {
  {
    "concept": "Mensualidad",
    "amount": 350.00,
    "dueDay": 10,
    "academicYearId": 1
  }
}
