meta {
  name: Create Payment
  type: http
  seq: 1
}

post {
  url: {{base_url}}/billing/payments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Tenant-Subdomain: {{subdomain}}
}

body:json {
  {
    "invoiceId": 1,
    "amount": 350.00,
    "paymentDate": "2026-03-08",
    "method": "TRANSFER",
    "receiptNumber": "REC-001",
    "notes": ""
  }
}
