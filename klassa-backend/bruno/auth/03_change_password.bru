meta {
  name: Change Password (first login)
  type: http
  seq: 3
}

put {
  url: {{base_url}}/auth/change-password
  body: json
  auth: none
}

headers {
  X-Tenant-Subdomain: {{subdomain}}
}

body:json {
  {
    "email": "director@colegio-demo.com",
    "currentPassword": "2a6b27008626A1!",
    "newPassword": "Bw'68$13i+q3L/!"
  }
}

docs {
  Endpoint público. Úsalo cuando POST /auth/login devuelve 403 PASSWORD_CHANGE_REQUIRED.
  Devuelve LoginResponse + cookie JWT lista para usar.
}
