meta {
  name: Create Family
  type: http
  seq: 1
}

post {
  url: {{base_url}}/families
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  X-Tenant-Subdomain: {{subdomain}}
}

