# ─── Database ────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/klassa_dev
DB_USERNAME=klassa
DB_PASSWORD=klassa

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Min 256 bits (32 chars). Change in prod.
JWT_SECRET=klassa-super-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm

# ─── Spring ──────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ─── Platform Admin (seed on first startup, then can be removed) ─────────────
PLATFORM_ADMIN_EMAIL=admin@klassa.com
PLATFORM_ADMIN_PASSWORD=change-me-immediately
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
